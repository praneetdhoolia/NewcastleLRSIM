{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/praneetdhoolia/NewcastleLRSIM/config/schema/registry.schema.json",
  "title": "Wickham registry document",
  "description": "One layer of the input registry. Field keys are dotted paths: <LAYER>.<GROUP>.<NAME>, e.g. B.activity.P_INTERMEDIATE_STOP. The layer letters follow proposal Appendix A-E: A network supply, B demand, C behaviour, D land use, E scenario config, plus RUN for execution-time control.",
  "type": "object",
  "required": [
    "layer",
    "title",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "layer": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "RUN"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "decisions_ref": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]+[.][a-z_0-9]+[.][A-Za-z_0-9.]+$"
      },
      "additionalProperties": {
        "$ref": "field.schema.json"
      }
    }
  }
}
