# Bulk data is not committed. Everything below is byte-reproducible from a city's
# own extract adapters and src/build, and every file is hashed in that city's
# data/MANIFEST.csv, which IS committed. See README.md "Reproducing".
#
# Every city-specific rule is written `cities/*/...`, so a second city inherits
# the same boundary without a second copy of this file.

# --- immutable third-party downloads (~1.8 GiB) ---
cities/*/data/raw/**
!cities/*/data/raw/provenance_*.json
!cities/*/data/raw/_s3_historical_gtfs_listing.txt

# --- raw Overpass extracts (~156 MB) ---
cities/*/networks/osm/*.osm

# --- source GTFS bundles (~230 MB) ---
cities/*/schedules/raw/**
!cities/*/schedules/raw/provenance.json

# --- generated GTFS variants (regenerate with build_era_feeds / build_scenario_schedules) ---
cities/*/schedules/*.zip
cities/*/schedules/scenarios/*.zip

# --- synthetic demand (~830 MB, seeded and deterministic) ---
cities/*/demand/population/*.csv
cities/*/demand/plans/*.csv

# --- MATSim plans (~93 MB, regenerate with build_matsim_plans). The report IS
#     committed: it carries the seed mode split and the plan/leg counts. ---
cities/*/demand/plans/matsim/**
!cities/*/demand/plans/matsim/_plans_report.json

# --- assembled MATSim run inputs (~77 MB: day-type-filtered schedules, patched
#     run networks and configs; regenerate with build_matsim_run_inputs). The
#     report IS committed: it carries the day-type split, the scoring
#     translation and what does not survive it. ---
cities/*/scenarios/matsim/**
!cities/*/scenarios/matsim/_run_inputs_report.json

# --- large derived geometry ---
cities/*/data/processed/network/*.jsonl
cities/*/data/processed/zones/*.gpkg

# --- P2 network build outputs (regenerate with build_matsim_network /
#     build_sumo_corridor). The build reports ARE committed: they carry the
#     mapping quality, the variant deltas and the signal pairing. ---
cities/*/networks/matsim/**
!cities/*/networks/matsim/_matsim_build_report.json
cities/*/networks/sumo/**
!cities/*/networks/sumo/_sumo_build_report.json

# --- TfNSW Speed Zones raw download (62 MB zip + a 436 MB dbf, regenerate with
#     the city's extract_speed_zones.py). The clipped study-area layer IS
#     committed; the statewide source is not.
cities/*/data/raw/speedzones/*.shp
cities/*/data/raw/speedzones/*.dbf
cities/*/data/raw/speedzones/*.shx
cities/*/data/raw/speedzones/*.prj
cities/*/data/raw/speedzones/*.zip

# --- pre-#32 OSM extracts, kept only until the re-harvest is verified
cities/*/networks/osm_pre_issue32/
cities/*/networks/osm/_tiles/

# --- pinned toolchain (JDK, pt2matsim, SUMO), ~1.4 GiB, fetched by
#     src/setup/bootstrap_toolchain.py and pinned by sha256 in toolchain.json ---
.tools/

# --- run outputs ---
results/**
!results/.gitkeep

# --- python ---
__pycache__/
*.pyc
.venv/

# --- local-only harness overrides (never committed) ---
.claude/settings.local.json

# --- credentials (never committed): the TfNSW Open Data Hub API key ---
.env
.env.*
!.env.example

# --- generated view payloads: megabytes of geometry, rebuilt by a committed
#     script from committed inputs. The scripts are the artefact, not the page.
#     basemap.json  src/analyse/build_basemap.py
#     replay.json / replay.html  src/analyse/replay_events.py, build_replay_page.py
basemap.json
replay.json
replay.html
