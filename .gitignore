# Bulk data is not committed. Everything below is byte-reproducible from
# src/extract and src/build, and every file is hashed in data/MANIFEST.csv,
# which IS committed. See README.md "Reproducing".

# --- immutable third-party downloads (~1.8 GiB) ---
data/raw/**
!data/raw/provenance_*.json
!data/raw/_s3_historical_gtfs_listing.txt

# --- raw Overpass extracts (~156 MB) ---
networks/osm/*.osm

# --- source GTFS bundles (~230 MB) ---
schedules/raw/**
!schedules/raw/provenance.json

# --- generated GTFS variants (regenerate with build_era_feeds / build_scenario_schedules) ---
schedules/*.zip
schedules/scenarios/*.zip

# --- synthetic demand (~830 MB, seeded and deterministic) ---
demand/population/*.csv
demand/plans/*.csv

# --- MATSim plans (~93 MB, regenerate with build_matsim_plans). The report IS
#     committed: it carries the seed mode split and the plan/leg counts. ---
demand/plans/matsim/**
!demand/plans/matsim/_plans_report.json

# --- assembled MATSim run inputs (~77 MB: day-type-filtered schedules, patched
#     run networks and configs; regenerate with build_matsim_run_inputs). The
#     report IS committed: it carries the day-type split, the scoring
#     translation and what does not survive it. ---
scenarios/matsim/**
!scenarios/matsim/_run_inputs_report.json

# --- large derived geometry ---
data/processed/network/*.jsonl
data/processed/zones/*.gpkg

# --- P2 network build outputs (regenerate with build_matsim_network /
#     build_sumo_corridor). The build reports ARE committed: they carry the
#     mapping quality, the variant deltas and the signal pairing. ---
networks/matsim/**
!networks/matsim/_matsim_build_report.json
networks/sumo/**
!networks/sumo/_sumo_build_report.json

# --- pinned toolchain (JDK, pt2matsim, SUMO), ~1.4 GiB, fetched by
#     src/setup/bootstrap_toolchain.py and pinned by sha256 in toolchain.json ---
.tools/

# --- run outputs ---
results/**
!results/.gitkeep

# --- python ---
__pycache__/
*.pyc
.venv/

# --- local-only harness overrides (never committed) ---
.claude/settings.local.json
